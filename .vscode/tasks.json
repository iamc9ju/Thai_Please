{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ThaiPlease: Web",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "--filter", "@thai-please/web", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "thai-please-dev",
        "focus": false,
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "ThaiPlease: API",
      "type": "shell",
      "command": "corepack",
      "args": ["pnpm", "--filter", "@thai-please/api", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "thai-please-dev",
        "focus": false,
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "ThaiPlease: Dev (Web + API)",
      "dependsOn": ["ThaiPlease: Web", "ThaiPlease: API"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
