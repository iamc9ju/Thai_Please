NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
ENABLE_SWAGGER=true
DATABASE_URL=postgresql://thai_please:replace-me@localhost:5432/thai_please?schema=public
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_MAX=10
POSTGRES_DB=thai_please
POSTGRES_USER=thai_please
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

# Development-only mock authentication. Never use real credentials here.
VITE_MOCK_AUTH_ENABLED=false
VITE_MOCK_CONSUMER_CITIZEN_ID=replace-me
VITE_MOCK_CONSUMER_PASSWORD=replace-me
VITE_MOCK_MERCHANT_CITIZEN_ID=replace-me
VITE_MOCK_MERCHANT_PASSWORD=replace-me
VITE_MOCK_ADMINISTRATOR_CITIZEN_ID=replace-me
VITE_MOCK_ADMINISTRATOR_PASSWORD=replace-me
